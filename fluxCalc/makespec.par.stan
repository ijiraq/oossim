stellartype M5  # stellar type (B0 B5 A0 A5 F0 F5 G0 G5 K0 K5 M0 M5)
metallicity 0   # stellar metallicty (-4 to 0, integers only)
specname specur # output name (anything you like, or "none" for no output)
exposure .03333 # exposure time in seconds
vmag 15         # V magnitude (AB)
diameter 8      # diameter in metres
pitch 0.04      # arcseconds per pixel
coating Gold    # mirror coating (Gold Aluminum Silver Perfect) case-sensitive
detector InSb   # detector (InSb HgCdTe PIN SiAs Perfect) caps matter
design gsfc     # the pupil design (gsfc trwd circ)
filter no       # filter yes/no (only first letter matters, not case-sensitive
wave1  0.1      # low  wavelength cutoff (only matters if filter=yes)
wave2 10.0      # high wavelength cutoff (only matters if filter=yes)

