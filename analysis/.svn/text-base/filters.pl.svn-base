#!/usr/bin/env perl
#
#

use strict;
use warnings;
use lib "$ENV{HOME}/libperl";
use Local::Filters;


my $usage = "Module Filters.pm\n\n".
    "functions: \@array = smooth(\$inArrRef, \$binwidth, \$kernel)\n".
    "           \@array = meanFilter(\$inArrRef, \$binwidth)\n".
    "           \@array = medianFilter(\$inArrRef, \$binwidth)\n".
    "           \@array = convFilter(\$inArrRef, \$filterRef)\n";

printf STDOUT "$usage";
